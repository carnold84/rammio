// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`Feature: generate > Scenario: valid inputs > creates a hook and its test 1`] = `
{
  "src/hooks/use-counter.test.ts": "import { act, renderHook } from "@testing-library/react";
import { describe, expect, it } from "vitest";
import { useCounter } from "./use-counter";

describe("useCounter", () => {
  it("returns the initial value", () => {
    const { result } = renderHook(() => useCounter("initial"));

    expect(result.current.value).toBe("initial");
  });

  it("updates the value", () => {
    const { result } = renderHook(() => useCounter());

    act(() => {
      result.current.setValue("next");
    });

    expect(result.current.value).toBe("next");
  });
});
",
  "src/hooks/use-counter.ts": "import { useState } from "react";

export type UseCounterResult = {
  setValue: (value: string) => void;
  value: string;
};

export function useCounter(initialValue = ""): UseCounterResult {
  const [value, setValue] = useState(initialValue);

  return { setValue, value };
}
",
}
`;

